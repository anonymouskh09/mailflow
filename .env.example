# ---- Core ----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mailflow:mailflow@localhost:5432/mailflow
REDIS_URL=redis://localhost:6379
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Long random string. Generate: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the dashboard (used for OAuth redirect)
APP_URL=http://localhost:5173
# Public URL used in tracking pixels / click / unsubscribe links (CNAME e.g. https://track.yourdomain.com)
TRACKING_URL=http://localhost:3000

# ---- Admin login (single user) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- Google OAuth (Connect with Google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Development helpers ----
# "minutes" makes sequence step delays count in minutes instead of days (testing only)
DELAY_UNIT=days
# Send every outgoing email through this SMTP server instead of the account's own (e.g. Mailpit).
# Leave empty in production.
DEV_SMTP_OVERRIDE=
# Disable the hourly sending schedule check (lets you test outside 09:00–17:00). Never in production.
DEV_IGNORE_SCHEDULE=false

# ---- Production only (docker-compose.prod.yml) ----
# APP_DOMAIN=app.yourdomain.com
# TRACKING_DOMAIN=track.yourdomain.com
# POSTGRES_PASSWORD=   (openssl rand -hex 24)
